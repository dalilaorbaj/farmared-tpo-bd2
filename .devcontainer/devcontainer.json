{
  "name": "FarmaRed - BD2",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "forwardPorts": [27017, 6379],
  "postCreateCommand": "pip install --user -r requirements.txt && python -m farmared.carga",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "mongodb.mongodb-vscode"
      ]
    }
  }
}
